# ========= 隐私红线：以下内容严禁进入版本库 =========

# 浏览器 profile 含登录 cookie/sessionKey，严禁上传
ff_profile_private/
ff_profile_normal/
ff_profile_private_test/
browser_profile/
chrome_debug_profile/

# 登录凭证 / cookie 导出文件（Claude sessionKey 等）
claude_cookies.json
*cookies*.json
*cookies*.sqlite
*.session

# GitHub PAT（新建仓库能力用）
github_token.txt
*.token

# 会话日志（含聊天内容）
logs/
*.log

# 项目会话（需求/各轮产出，属本地隐私）
projects/

# 会话复用状态（含各站点会话 URL）
state/

# 模型产出默认不上传（含任务提示词与模型原始回复；需要分享时手动 git add -f）
outputs/

# 运行时产物
__pycache__/
*.pyc
.trae/
*.sqlite
*.db
